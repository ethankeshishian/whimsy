+  // Whimsy: semantic article structures are often short or link-heavy.
+  // Protect them from prose heuristics, without retaining page navigation.
+  _isRichContent(node) {
+    var tag = node.tagName.toLowerCase();
+    var classes = node.getAttribute("class") || "";
+    return (
+      tag === "figure" || tag === "math" ||
+      node.getAttribute("role") === "doc-endnotes" ||
+      /(?:^|\s)(?:infobox|references|reflist|reference|whimsy-reader-formula)(?:\s|$)/.test(classes) ||
+      (tag === "table" && node.getAttribute("role") !== "presentation" &&
+        this._getAllNodesWithTag(node, ["th", "caption", "thead"]).length > 0)
+    );
+  },
+
+  _prepareRichContent() {
+    // These are publishing conventions, independent of the article's host.
+    // Remove them before scoring, even when nested inside a data table.
+    this._removeNodes(this._getAllNodesWithTag(this._doc, ["div", "span", "table", "aside", "nav", "a"]), function (node) {
+      return /(?:^|\s)(?:hatnote|navbox|mw-editsection|editsection)(?:\s|$)/.test(node.getAttribute("class") || "") ||
+        node.getAttribute("role") === "navigation" ||
+        /(?:^|\s)edit(?:\s|$)/.test(node.getAttribute("rel") || "");
+    });
+
+    var maths = this._getAllNodesWithTag(this._doc, ["math"]);
+    this._forEachNode(maths, function (math) {
+      // Publishers hide native MathML behind their own CSS and show an image.
+      // Reader has native MathML support, but none of that publisher CSS.
+      var wrapper = math;
+      while (wrapper.parentNode &&
+        /math/i.test(wrapper.parentNode.getAttribute?.("class") || "")) {
+        wrapper = wrapper.parentNode;
+      }
+      var current = math;
+      while (current) {
+        current.removeAttribute("hidden");
+        current.removeAttribute("aria-hidden");
+        current.removeAttribute("style");
+        if (current === wrapper) {
+          break;
+        }
+        current = current.parentNode;
+      }
+      this._removeNodes(this._getAllNodesWithTag(wrapper, ["img"]), function (img) {
+        return /(?:math.*fallback|fallback.*math)/i.test(img.getAttribute("class") || "");
+      });
+    });
+    this._forEachNode(this._getAllNodesWithTag(this._doc, ["img"]), function (img) {
+      if (/(?:math.*fallback|fallback.*math)/i.test(img.getAttribute("class") || "")) {
+        img.removeAttribute("aria-hidden");
+        img.className += " whimsy-reader-formula";
+      }
+    });
+  },
