+// Whimsy (Mini Whimsy, W10-13): a browser window whose root element carries
+// whimsy-popups-as-tabs keeps everything its pages open as its own tabs,
+// sign-in popups (window.open with features) included, so they keep their
+// opener and postMessage. The attribute is Mini's (WhimsyQuickWindow).
+static bool WhimsyOpensPopupsAsTabs(nsPIDOMWindowOuter* aParent) {
+  nsPIDOMWindowOuter* root = aParent ? aParent->GetPrivateRoot() : nullptr;
+  Document* doc = root ? root->GetExtantDoc() : nullptr;
+  Element* element = doc ? doc->GetRootElement() : nullptr;
+  return element && element->HasAttribute(u"whimsy-popups-as-tabs"_ns);
+}
