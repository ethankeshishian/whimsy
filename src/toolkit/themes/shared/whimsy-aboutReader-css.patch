diff --git a/toolkit/themes/shared/aboutReader.css b/toolkit/themes/shared/aboutReader.css
--- a/toolkit/themes/shared/aboutReader.css
+++ b/toolkit/themes/shared/aboutReader.css
@@ -1222,3 +1222,60 @@
 .radiorow>label:hover::after {
   border: none !important;
 }
+
+/* Whimsy: article structures use Reader's existing type and color tokens. */
+.moz-reader-content {
+  overflow-wrap: anywhere;
+}
+
+.moz-reader-content * {
+  min-width: 0;
+}
+
+.moz-reader-content :is(img, video, audio, svg, iframe, object, embed) {
+  max-width: 100%;
+}
+
+.moz-reader-content pre {
+  white-space: pre;
+  overflow-wrap: normal;
+  overflow-x: auto;
+}
+
+.moz-reader-content pre code {
+  white-space: inherit;
+  overflow-wrap: normal;
+}
+
+.moz-reader-content .whimsy-reader-table {
+  width: 100%;
+  min-width: 0;
+  max-width: 100%;
+  overflow-x: auto;
+  margin-block: 1em;
+  /* Preserve intrinsic columns; long table tokens scroll with their table. */
+  overflow-wrap: normal;
+}
+
+.moz-reader-content .whimsy-reader-table > table {
+  margin: 0;
+}
+
+.moz-reader-content img.whimsy-reader-formula {
+  display: inline;
+  vertical-align: middle;
+  margin: 0;
+}
+
+.moz-reader-content math {
+  font-family: math;
+  display: inline-block;
+  max-width: 100%;
+  overflow-x: auto;
+  vertical-align: middle;
+}
+
+.moz-reader-content math[display="block"] {
+  display: block;
+  overflow-x: auto;
+}
