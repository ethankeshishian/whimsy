+// Persist the exact manifest with the add-on metadata. A version and permission
+// comparison misses edits to scripts, names, and other manifest fields. Keeping
+// the previous contents also remembers a refusal across process restarts.
+function whimsyPluginManifest(addon) {
+  let manifest = addon._sourceBundle.clone();
+  manifest.append("manifest.json");
+  return Cu.readUTF8File(manifest);
