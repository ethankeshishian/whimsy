+/**
+ * Whimsy: whether a local plugin's changed manifest needs the owner's
+ * approval again: a new version, or any permission, site, or data
+ * collection it didn't ask for before.
+ *
+ * @param {AddonInternal} oldAddon
+ * @param {AddonInternal} newAddon
+ * @returns {boolean}
+ */
+function whimsyPluginNeedsApproval(oldAddon, newAddon) {
+  if (oldAddon.version != newAddon.version) {
+    return true;
+  }
+  let asked = addon => {
+    let set = new Set();
+    for (let perms of [addon.userPermissions, addon.requestedPermissions]) {
+      for (let key of ["permissions", "origins", "data_collection"]) {
+        for (let value of perms?.[key] ?? []) {
+          set.add(`${key}:${value}`);
+        }
+      }
+    }
+    return set;
+  };
+  let before = asked(oldAddon);
+  return [...asked(newAddon)].some(perm => !before.has(perm));
+}
