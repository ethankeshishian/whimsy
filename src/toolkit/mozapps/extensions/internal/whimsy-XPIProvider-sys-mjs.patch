+/**
+ * Whimsy: the owner's local plugins, <profile>/whimsy-plugins. Each plugin is
+ * a real folder (not a link, pointer file or .xpi) directly inside it that
+ * holds an unpacked WebExtension whose manifest.json names its id in
+ * browser_specific_settings.gecko.id. Signing is waived only for add-ons
+ * loaded from here (AddonInternal.isCorrectlySigned checks the location and
+ * that the add-on's folder really is one of these). A folder carries no
+ * signature, so a plugin is never privileged. The location is locked, so no
+ * install (from a page, a file, or about:addons) can put anything here; the
+ * only way in is a file the owner writes into the folder. New plugins, and
+ * a running plugin whose version or permissions change, start turned off
+ * until the owner approves them (XPIDatabaseReconcile).
+ */
+class WhimsyPluginsLocation extends DirectoryLocation {
+  constructor(name, dir, scope) {
+    super(name, dir, scope, /* locked */ true, /* system */ false);
+  }
+
+  /**
+   * Whether aFile is a plugin folder of this location: a real directory
+   * whose parent is this location's own (real) directory.
+   *
+   * @param {nsIFile?} aFile
+   * @returns {boolean}
+   */
+  isWhimsyPluginFolder(aFile) {
+    try {
+      return (
+        !!aFile &&
+        this._isRealDir(this.dir) &&
+        this._isRealDir(aFile) &&
+        !!aFile.parent &&
+        aFile.parent.equals(this.dir)
+      );
+    } catch (e) {
+      return false;
+    }
+  }
+
+  _isRealDir(aFile) {
+    try {
+      return aFile.exists() && !aFile.isSymlink() && aFile.isDirectory();
+    } catch (e) {
+      return false;
+    }
+  }
+
+  /**
+   * True when nothing inside the plugin folder is a symlink (which could
+   * point outside it) or anything but plain files and folders, within
+   * limits that keep the startup scan cheap. A folder that can't be read
+   * fully counts as not self-contained.
+   *
+   * @param {nsIFile} aDir
+   * @returns {boolean}
+   */
+  _isSelfContained(aDir) {
+    let budget = 4096;
+    let walk = (dir, depth) => {
+      if (depth > 16) {
+        return false;
+      }
+      let entries = dir.directoryEntries;
+      try {
+        let entry;
+        while ((entry = entries.nextFile)) {
+          if (--budget < 0 || entry.isSymlink()) {
+            return false;
+          }
+          if (entry.isDirectory()) {
+            if (!walk(entry, depth + 1)) {
+              return false;
+            }
+          } else if (!entry.isFile()) {
+            return false;
+          }
+        }
+      } finally {
+        entries.close();
+      }
+      return true;
+    };
+    try {
+      return walk(aDir, 0);
+    } catch (e) {
+      logger.warn(`Can't read local plugin folder ${aDir.path}`, e);
+      return false;
+    }
+  }
+
+  /**
+   * The add-on id a plugin folder's manifest.json names, or null.
+   *
+   * @param {nsIFile} aDir
+   * @returns {string?}
+   */
+  _readId(aDir) {
+    let manifest = aDir.clone();
+    manifest.append("manifest.json");
+    if (
+      !manifest.exists() ||
+      manifest.isSymlink() ||
+      !manifest.isFile() ||
+      manifest.fileSize > 1024 * 1024
+    ) {
+      return null;
+    }
+    // Like ExtensionData.readJSON, lines that start with // are comments.
+    let text = Cu.readUTF8File(manifest).replace(/^\s*\/\/.*/gm, "");
+    let json = JSON.parse(text);
+    let gecko = (json?.browser_specific_settings || json?.applications)
+      ?.gecko;
+    let id = gecko?.id;
+    return typeof id == "string" && gIDTest.test(id) ? id : null;
+  }
+
+  isLinkedAddon(/* aId */) {
+    return false;
+  }
+
+  readAddons() {
+    let addons = new Map();
+    if (!this._isRealDir(this.dir)) {
+      return addons;
+    }
+    let skipped = new Set();
+    for (let entry of Array.from(iterDirectory(this.dir))) {
+      if (entry.leafName.startsWith(".")) {
+        continue;
+      }
+      // Only real folders: no .xpi files, pointer files, or symlinks, so
+      // nothing outside this folder is ever loaded from here.
+      if (!this._isRealDir(entry)) {
+        logger.warn(`Ignoring local plugin ${entry.path}: not a folder`);
+        continue;
+      }
+      let id = null;
+      try {
+        id = this._readId(entry);
+      } catch (e) {
+        logger.warn(`Can't read local plugin manifest in ${entry.path}`, e);
+      }
+      if (!id) {
+        logger.warn(
+          `Ignoring local plugin ${entry.path}: manifest.json must name an id in browser_specific_settings.gecko.id`
+        );
+        continue;
+      }
+      if (!this._isSelfContained(entry)) {
+        logger.warn(
+          `Ignoring local plugin ${entry.path}: it contains a link or special file`
+        );
+        continue;
+      }
+      // A plugin never takes over an id another location already holds.
+      if (XPIStates.findAddon(id, loc => loc !== this)) {
+        logger.warn(
+          `Ignoring local plugin ${entry.path}: ${id} is already installed`
+        );
+        continue;
+      }
+      // Two folders claiming one id: load neither.
+      if (addons.has(id) || skipped.has(id)) {
+        logger.warn(`Ignoring local plugins that share the id ${id}`);
+        addons.delete(id);
+        skipped.add(id);
+        continue;
+      }
+      addons.set(id, entry);
+    }
+    return addons;
+  }
+}
