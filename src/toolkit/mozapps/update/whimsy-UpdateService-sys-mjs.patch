@@ -1957,6 +1957,17 @@ function updateIsAtLeastAsOldAs(update, version, buildID) {
     return false;
   }
   let versionComparison = Services.vc.compare(update.appVersion, version);
+  // Whimsy: every Whimsy build of a Zen release shares its appVersion, so at
+  // the same version order by build ID (a YYYYMMDDHHMMSS timestamp) instead
+  // of only matching it; an older build is never installed over a newer one.
+  if (
+    versionComparison == 0 &&
+    /^\d+$/.test(update.buildID) &&
+    /^\d+$/.test(buildID) &&
+    update.buildID.length == buildID.length
+  ) {
+    return update.buildID <= buildID;
+  }
   return (
