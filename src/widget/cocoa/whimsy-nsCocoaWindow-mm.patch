+// Whimsy: Liquid Glass (Settings > Look and Feel, off by default). On macOS
+// 26 and later the browser window's backdrop becomes the system's glass
+// material (NSGlassEffectView, as Gecko already uses for menus) instead of
+// Zen's blurred NSVisualEffectView, so the sidebar and toolbars, which
+// Whimsy's transparency makes see-through, sit on real glass. AppKit adapts
+// the glass to Reduce Transparency and Increase Contrast itself. Older
+// macOS keeps Zen's material.
+static constexpr nsLiteralCString kWhimsyLiquidGlassPrefs[] = {
+    "whimsy.look.liquid-glass"_ns,
+    "whimsy.feature.liquid-glass"_ns,
+};
+
+static bool WhimsyWantsLiquidGlass() {
+  if (@available(macOS 26.0, *)) {
+    return Preferences::GetBool("whimsy.feature.liquid-glass", true) &&
+           Preferences::GetBool("whimsy.look.liquid-glass", false);
+  }
+  return false;
+}
+
+static bool WhimsyIsLiquidGlass(NSView* aView) {
+  if (@available(macOS 26.0, *)) {
+    return [aView isKindOfClass:[NSGlassEffectView class]];
+  }
+  return false;
+}
