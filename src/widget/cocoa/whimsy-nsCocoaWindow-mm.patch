+void nsCocoaWindow::SetAlwaysOnTop(bool aOnTop) {
+  NS_OBJC_BEGIN_TRY_IGNORE_BLOCK;
 
+  if (mAlwaysOnTop == aOnTop) {
+    return;
+  }
