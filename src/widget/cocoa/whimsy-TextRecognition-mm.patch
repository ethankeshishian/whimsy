 namespace mozilla::widget {
 
+// Whimsy: recognitions run on a GCD queue that shutdown never joins, so a
+// read can outlive the browser's teardown. Each pending promise is tracked
+// here. Early in shutdown, while the main thread still runs, every pending
+// promise is rejected and the shutdown flag is set. A queue block that
+// finishes after that drops its result instead of settling the promise or
+// building Gecko objects.
+namespace {
+using PendingPromise = TextRecognition::NativePromise::Private;
+
+StaticMutex sPendingMutex;
+StaticAutoPtr<nsTArray<RefPtr<PendingPromise>>> sPending
+    MOZ_GUARDED_BY(sPendingMutex);
+bool sPendingShutDown MOZ_GUARDED_BY(sPendingMutex) = false;
+
+void RejectPendingAtShutdown() {
+  nsTArray<RefPtr<PendingPromise>> pending;
+  {
+    StaticMutexAutoLock lock(sPendingMutex);
+    sPendingShutDown = true;
+    if (sPending) {
+      pending = std::move(*sPending);
+      sPending = nullptr;
+    }
+  }
+  for (auto& promise : pending) {
+    promise->Reject("Shutting down"_ns, __func__);
+  }
+}
+
+// Main thread. False once shutdown has begun.
+bool TrackPending(PendingPromise* aPromise) {
+  if (!NS_IsMainThread() ||
+      AppShutdown::IsInOrBeyond(ShutdownPhase::XPCOMWillShutdown)) {
+    return false;
+  }
+  static bool sRegistered = false;
+  if (!sRegistered) {
+    sRegistered = true;
+    RunOnShutdown(RejectPendingAtShutdown, ShutdownPhase::XPCOMWillShutdown);
+  }
+  StaticMutexAutoLock lock(sPendingMutex);
+  if (sPendingShutDown) {
+    return false;
+  }
+  if (!sPending) {
+    sPending = new nsTArray<RefPtr<PendingPromise>>();
+  }
+  sPending->AppendElement(aPromise);
+  return true;
+}
+
+// Any thread. False if shutdown has already settled the promise.
+bool IsShuttingDown() {
+  StaticMutexAutoLock lock(sPendingMutex);
+  return sPendingShutDown;
+}
+
+// Queue thread. False if shutdown has already settled the promise; the
+// caller must then leave it alone.
+bool UntrackPending(PendingPromise* aPromise) {
+  StaticMutexAutoLock lock(sPendingMutex);
+  if (sPendingShutDown) {
+    return false;
+  }
+  if (sPending) {
+    sPending->RemoveElement(aPromise);
+  }
+  return true;
+}
