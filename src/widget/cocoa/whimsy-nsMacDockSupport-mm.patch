+NS_IMETHODIMP
+nsMacDockSupport::SetApplicationIcon(imgIContainer* aImage) {
+  NS_OBJC_BEGIN_TRY_BLOCK_RETURN
+
+  NSImage* image = nil;
+  if (aImage) {
+    image = [MOZIconHelper iconImageFromImageContainer:aImage
+                                              withSize:NSMakeSize(1024, 1024)
+                                            svgContext:nullptr
+                                           scaleFactor:0.0];
+    if (!image) {
+      return NS_ERROR_FAILURE;
+    }
+  }
+
+  // nil restores the bundle icon. This also updates the image named
+  // NSApplicationIcon, which the custom dock tile below is built from.
+  [NSApp setApplicationIconImage:image];
+
+  if (mDockTileWrapperView) {
+    for (NSView* view in mDockTileWrapperView.subviews) {
+      if ([view isKindOfClass:[NSImageView class]] && view != mDockBadgeView) {
+        ((NSImageView*)view).image = [NSImage imageNamed:@"NSApplicationIcon"];
+        break;
+      }
+    }
+    [NSApp.dockTile display];
+  }
+
+  return NS_OK;
+
+  NS_OBJC_END_TRY_BLOCK_RETURN(NS_ERROR_FAILURE)
+}
