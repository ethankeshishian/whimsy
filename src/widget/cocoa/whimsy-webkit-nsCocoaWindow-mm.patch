 // Allow this to be a 'focused' widget for event dispatch.
 - (BOOL)acceptsFirstResponder {
   return YES;
 }
+
+// Whimsy WebKit tabs: when a native WKWebView sits below Gecko's ChildView,
+// return nil inside the web view's uncovered hole rects so AppKit routes mouse,
+// scroll, cursor, and drag events to the native sibling below while Gecko's
+// chrome and overlays painted outside the hole still receive hits.
+- (NSView*)hitTest:(NSPoint)aPoint {
+  NSView* hit = [super hitTest:aPoint];
+  if (hit == self) {
+    NSArray<NSValue*>* holes =
+        objc_getAssociatedObject(self, @selector(whimsyNativeHoles));
+    if (holes.count) {
+      NSPoint local = [self convertPoint:aPoint fromView:[self superview]];
+      for (NSValue* val in holes) {
+        if (NSPointInRect(local, [val rectValue])) {
+          return nil;
+        }
+      }
+    }
+  }
+  return hit;
+}
 
