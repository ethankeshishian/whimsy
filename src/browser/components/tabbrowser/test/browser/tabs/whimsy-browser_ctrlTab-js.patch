+// Whimsy: Zen keeps a hidden placeholder tab ("zen-empty-tab", made by
+// ZenSpaceManager's #initializeEmptyTab) at the start of gBrowser.tabs, so
+// every tab count and index in this file would be one off (and the "close
+// down to one tab" loops would close the last real tab). This file sees the
+// tab strip without it; everything else goes to the real gBrowser, which
+// is also what BrowserTestUtils gets (it checks identity).
+const gBrowser = (() => {
+  const real = window.gBrowser;
+  const tabs = () => real.tabs.filter(t => !t.hasAttribute("zen-empty-tab"));
+  const forward = () => ({
+    get(obj, prop) {
+      const value = Reflect.get(obj, prop, obj);
+      return typeof value == "function" ? value.bind(obj) : value;
+    },
+    set(obj, prop, value) {
+      return Reflect.set(obj, prop, value, obj);
+    },
+  });
+  const tabContainer = new Proxy(real.tabContainer, {
+    ...forward(),
+    get(obj, prop) {
+      if (prop == "selectedIndex") {
+        return tabs().indexOf(real.selectedTab);
+      }
+      return forward().get(obj, prop);
+    },
+  });
+  return new Proxy(real, {
+    ...forward(),
+    get(obj, prop) {
+      if (prop == "tabs") {
+        return tabs();
+      }
+      if (prop == "tabContainer") {
+        return tabContainer;
+      }
+      return forward().get(obj, prop);
+    },
+  });
+})();
