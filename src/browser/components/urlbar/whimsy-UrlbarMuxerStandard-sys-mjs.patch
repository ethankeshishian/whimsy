+  /**
+   * Whimsy (W11-09): the command bar's open-tab ranking, as in Arc.
+   * WhimsyAlreadyOpen sets `whimsyOpenTabFirst` on the query context of
+   * Zen's Cmd+T command bar (or typing into an empty tab), and only there,
+   * so every other query keeps Firefox's order. When what you typed
+   * matches an open tab, that tab's Switch to Tab row comes first, above the
+   * typed address or search, and Return picks it. Firefox picks the heuristic
+   * (first) result on Return and builds selection, autofill and row reuse on
+   * it being first, so the tab's row becomes the heuristic and the
+   * provider's heuristic becomes the second row. A typed address only ranks
+   * the tab showing that very page; a search ranks the best open-tab match
+   * Firefox found for it. Only tabs in the container and privacy the new tab
+   * would get. With no such tab nothing changes, so Return still goes to the
+   * typed address or search.
+   *
+   * @param {UrlbarQueryContext} context
+   */
+  #whimsyRankOpenTabs(context) {
+    let results = context.results;
+    if (!results?.length) {
+      return;
+    }
+    let { TAB_SWITCH, URL, SEARCH } = lazy.UrlbarShared.RESULT_TYPE;
+    let wanted = context.whimsyOpenTabFirst;
+    let heuristic = results[0];
+    if (
+      !wanted ||
+      context.searchMode ||
+      !heuristic.heuristic ||
+      !WHIMSY_RANKABLE_HEURISTICS.has(heuristic.providerName) ||
+      heuristic.payload.keyword ||
+      (heuristic.type != URL && heuristic.type != SEARCH)
+    ) {
+      return;
+    }
+    let page = null;
+    if (heuristic.type == URL) {
+      page = whimsyPageKey(heuristic.payload.url);
+      if (!page) {
+        return;
+      }
+    }
+    let index = results.findIndex(
+      result =>
+        result.type == TAB_SWITCH &&
+        !result.heuristic &&
+        !result.hasSuggestedIndex &&
+        (result.payload.userContext?.id ?? 0) == wanted.userContextId &&
+        (!page || whimsyPageKey(result.payload.url) == page)
+    );
+    if (index < 1) {
+      return;
+    }
+    let [tab] = results.splice(index, 1);
+    results.unshift(tab);
+    tab.whimsyOwnHeuristic = false;
+    tab.heuristic = true;
+    heuristic.whimsyOwnHeuristic = true;
+    heuristic.heuristic = false;
+    // The view (allowEmptySelection) and Return before the results show
+    // (getHeuristicResult) read the context's heuristic, not results[0].
+    context.heuristicResult = tab;
+    // Whimsy (F34): a typed address of the page the tab shows would be a
+    // second row for the same page: it's left out, and a modified Return on
+    // the tab (Option-Return, a new tab) still goes to it.
+    if (page) {
+      results.splice(results.indexOf(heuristic), 1);
+      tab.whimsyTypedResult = heuristic;
+    }
+  }
