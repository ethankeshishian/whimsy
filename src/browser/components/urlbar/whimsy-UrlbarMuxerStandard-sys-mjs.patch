+  /**
+   * Whimsy (W11-09): undoes #whimsyRankOpenTabs on the query's results, so
+   * each sort starts from the providers' own heuristic.
+   *
+   * @param {UrlbarQueryContext} context
+   * @param {Array} unsortedResults
+   */
+  #whimsyUndoOpenTabFirst(context, unsortedResults) {
+    if (!context.whimsyOpenTabFirst) {
