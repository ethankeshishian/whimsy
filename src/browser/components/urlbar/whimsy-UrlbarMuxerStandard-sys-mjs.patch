 /**
+ * Whimsy (W11-09): the page an address shows, compared the way
+ * WhimsyAlreadyOpen compares them: without the fragment, http and https
+ * alike (HTTPS-First upgrades typed addresses). Null for other schemes.
+ *
+ * @param {string} spec
+ * @returns {?string}
+ */
+function whimsyPageKey(spec) {
+  try {
+    let uri = Services.io.newURI(spec);
+    if (uri.scheme != "http" && uri.scheme != "https") {
+      return null;
+    }
+    return uri.specIgnoringRef.replace(/^http:/, "https:");
+  } catch {
+    return null;
+  }
+}
