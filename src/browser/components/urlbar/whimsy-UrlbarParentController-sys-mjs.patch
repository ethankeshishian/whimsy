+  // Whimsy: whether the input serves private browsing. A normal window can
+  // hold private tabs (WhimsyPrivate), and this controller outlives tab
+  // switches, so ask the page the input lives in (an in-content urlbar), or
+  // the window's selected tab, each time.
+  #initialPrivate = false;
+
+  get isPrivate() {
+    if (this.#initialPrivate) {
+      return true;
+    }
+    if (this.#actor?.browsingContext?.usePrivateBrowsing) {
+      return true;
+    }
+    let browser = this.browserWindow?.gBrowser?.selectedBrowser;
+    return !!browser && lazy.PrivateBrowsingUtils.isBrowserPrivate(browser);
   }
 
+  set isPrivate(value) {
+    this.#initialPrivate = !!value;
+  }
