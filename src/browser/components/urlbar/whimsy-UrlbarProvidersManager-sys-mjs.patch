diff --git a/browser/components/urlbar/UrlbarProvidersManager.sys.mjs b/browser/components/urlbar/UrlbarProvidersManager.sys.mjs
index e6be27e..91350f0 100644
--- a/browser/components/urlbar/UrlbarProvidersManager.sys.mjs
+++ b/browser/components/urlbar/UrlbarProvidersManager.sys.mjs
@@ -1024,10 +1024,16 @@ export class Query {
       });
     } else if (
       !this.context.pendingHeuristicProviders.size &&
-      provider.type == lazy.UrlbarShared.PROVIDER_TYPE.HEURISTIC
+      provider.type == lazy.UrlbarShared.PROVIDER_TYPE.HEURISTIC &&
+      !this._whimsyHeuristicFired?.has(provider)
     ) {
       // All the active heuristic providers have returned results, we can skip
