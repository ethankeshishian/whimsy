# w7native/captions: Apple's on-device speech recognizer (Speech framework)
# for live captions of videos without any. Only built on macOS (see
# ../moz.build); the app's Info.plist carries
# NSSpeechRecognitionUsageDescription (whimsy-Info-plist-in.patch).

XPIDL_SOURCES += [
    "nsIWhimsySpeech.idl",
]

XPIDL_MODULE = "whimsy_speech"

EXPORTS.mozilla += [
    "nsWhimsySpeech.h",
]

SOURCES += [
    "nsWhimsySpeech.mm",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

OS_LIBS += [
    "-framework AVFoundation",
    "-framework Speech",
]

FINAL_LIBRARY = "xul"
