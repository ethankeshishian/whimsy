#include "nsISupports.idl"

/**
 * @brief Handed the answer of nsIWhimsySpeech.requestAccess, on the main
 * thread.
 */
[scriptable, function, uuid(b8e0ac30-d3cf-46aa-a43d-f8b6fb61b3ac)]
interface nsIWhimsySpeechCallback : nsISupports {
  /**
   * @param result The authorization status afterwards (see
   *        nsIWhimsySpeech.authorizationStatus), or
   *        "missing-usage-description" when the app's Info.plist lacks
   *        NSSpeechRecognitionUsageDescription (macOS would end the app).
   */
  void onComplete(in boolean granted, in AUTF8String result);
};

/**
 * @brief Hears what a recognition session makes of its audio, on the main
 * thread.
 */
[scriptable, uuid(11fd4132-c7f7-47cc-ac30-09b681dece4d)]
interface nsIWhimsySpeechListener : nsISupports {
  /**
   * @param text What was said in the current stretch of audio so far,
   *        punctuated where macOS can. A session starts a new stretch every
   *        so often (and after each pause macOS ends), so `text` restarts
   *        then.
   * @param isFinal Whether this stretch is done; the next text starts a
   *        new one.
   */
  void onText(in AUTF8String text, in boolean isFinal);

  /**
   * @param reason "unavailable" (no on-device recognizer for the locale),
   *        "not-authorized" or "failed". The session has stopped.
   */
  void onError(in AUTF8String reason);
};

/**
 * @brief One live recognition: audio in, text out. Main thread only.
 */
[scriptable, uuid(6d0ad660-b761-4e21-93d6-beda794bcc62)]
interface nsIWhimsySpeechSession : nsISupports {
  /**
   * @brief Feeds mono samples (-1..1) at `sampleRate` Hz. A rate change
   * starts a new stretch.
   */
  void appendAudio(in Array<float> samples, in unsigned long sampleRate);

  /** @brief Ends the session; its listener hears nothing more. */
  void stop();

  readonly attribute AUTF8String locale;
};

/**
 * @brief W23 voice-image: hears the Fn (globe) key while Whimsy is the
 * frontmost app, on the main thread. Gecko doesn't send key events for Fn.
 */
[scriptable, function, uuid(5f0e4b8a-2a43-4c55-9d1e-7a3c2b9e61f4)]
interface nsIWhimsyFnListener : nsISupports {
  /**
   * @param what "down", "up", or "other-key" (another key went down while
   *        Fn was held, so Fn is a modifier this time).
   */
  void onFn(in ACString what);
};

/** @brief A running Fn watch. */
[scriptable, uuid(0c6d3f2e-8b7a-4e1d-a5c9-3e2f1b6d7a80)]
interface nsIWhimsyFnWatch : nsISupports {
  void stop();
};

/**
 * @brief W23 voice-image: dictation from the microphone, on this Mac only.
 * Listening starts with nsIWhimsySpeech.listen and lasts until finish() or
 * stop(); the microphone is off from the moment either is called.
 */
[scriptable, uuid(9a4c1e7d-6b2f-4f3a-8d5e-1c7b9e2a4f63)]
interface nsIWhimsyMicSession : nsISupports {
  /**
   * @brief Turns the microphone off and lets the recognizer finish: the
   * listener hears the whole text once more with isFinal (punctuated), or
   * an error, then nothing.
   */
  void finish();

  /** @brief Turns the microphone off; the listener hears nothing more. */
  void stop();

  readonly attribute AUTF8String locale;
};

/**
 * @brief Apple's speech recognizer (Speech framework), on this Mac only:
 * every session sets requiresOnDeviceRecognition, so no audio leaves the
 * Mac, and a locale without an on-device model is refused. Only Whimsy's
 * live captions use it once the person turns on CC for a video without
 * captions, and dictation once they hold Fn or click the command bar's mic:
 * nothing here asks for access on its own.
 */
[scriptable, uuid(3d8f6a21-7c4e-4b9a-b1f2-6e0d5c3a9b74)]
interface nsIWhimsySpeech : nsISupports {
  /**
   * @brief One of "notDetermined", "denied", "restricted", "authorized".
   */
  readonly attribute ACString authorizationStatus;

  /** @brief Asks macOS (its prompt shows the first time only). */
  void requestAccess(in nsIWhimsySpeechCallback callback);

  /**
   * @brief The locales ("en-US", "es-ES", ...) with an on-device model on
   * this Mac. Models come with Dictation's languages (System Settings →
   * Keyboard → Dictation).
   */
  readonly attribute Array<AUTF8String> onDeviceLocales;

  /**
   * @brief Starts recognizing speech in `locale` (one of onDeviceLocales).
   * Fails with NS_ERROR_NOT_AVAILABLE when access isn't granted or the
   * locale has no on-device model.
   */
  nsIWhimsySpeechSession start(in AUTF8String locale,
                               in nsIWhimsySpeechListener listener);

  /**
   * @brief The microphone's authorization status, named like
   * authorizationStatus.
   */
  readonly attribute ACString microphoneStatus;

  /** @brief Asks macOS for the microphone (its prompt shows the first time only). */
  void requestMicrophoneAccess(in nsIWhimsySpeechCallback callback);

  /**
   * @brief Starts dictation: the default microphone, recognized in `locale`
   * (one of onDeviceLocales). Fails with NS_ERROR_NOT_AVAILABLE when the
   * microphone or speech recognition isn't authorized, the locale has no
   * on-device model, or there is no microphone.
   */
  nsIWhimsyMicSession listen(in AUTF8String locale,
                             in nsIWhimsySpeechListener listener);

  /** @brief Watches the Fn key until the watch is stopped. */
  nsIWhimsyFnWatch watchFnKey(in nsIWhimsyFnListener listener);

  /**
   * @brief What macOS does on a press of Fn (System Settings › Keyboard,
   * "Press 🌐 key to"): 0 nothing, 1 change the input source, 2 show emoji,
   * 3 start dictation, -1 not set (macOS's default, which isn't nothing).
   */
  readonly attribute long fnKeyUsage;

  /**
   * @brief Opens a System Settings page: "keyboard", "microphone" or
   * "speech-recognition" (Privacy & Security).
   */
  void openSystemSettings(in ACString page);
};
