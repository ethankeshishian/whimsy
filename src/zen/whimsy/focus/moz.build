# wave7/native1: macOS Focus for Whimsy's own toasts (WhimsyFocus.sys.mjs).
# Only built on macOS (see ../moz.build). Info.plist carries
# NSFocusStatusUsageDescription (whimsy-Info-plist-in.patch);
# INFocusStatusCenter also needs an entitlement Whimsy's ad-hoc signature
# can't carry, so the FSEvents watch of Focus's database does the work.

XPIDL_SOURCES += [
    "nsIWhimsyFocus.idl",
]

XPIDL_MODULE = "whimsy_focus"

EXPORTS.mozilla += [
    "nsWhimsyFocus.h",
]

SOURCES += [
    "nsWhimsyFocus.mm",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

OS_LIBS += [
    "-framework CoreServices",
    "-framework Intents",
    "-framework Security",
]

FINAL_LIBRARY = "xul"
