#include "nsISupports.idl"

interface mozIDOMWindowProxy;

// W32: one interface for every engine Whimsy can show a tab in (it was
// nsIWhimsyWebKit). Each engine is a service under
// @mozilla.org/whimsy/engine-tab;1?engine=<name>; WebKit's also keeps its old
// contract, @mozilla.org/whimsy/webkit;1.

[scriptable, function, uuid(22804b07-918c-41ce-9c2c-5239db6f739c)]
interface nsIWhimsyEngineTabListener : nsISupports
{
  void onEvent(in uint32_t aId, in AString aType, in AString aData);
};

[scriptable, uuid(a78c49ce-fc6e-45bc-b539-c5f2fb1438a1)]
interface nsIWhimsyEngineTab : nsISupports
{
  // The engine this service runs: "webkit".
  readonly attribute ACString engine;

  boolean available(in mozIDOMWindowProxy aWindow);

  uint32_t createTab(in mozIDOMWindowProxy aWindow,
                     in AString aDataStoreId,
                     in AString aLayerMode,
                     in nsIWhimsyEngineTabListener aListener);

  void setFrame(in uint32_t aId,
                in double aX,
                in double aY,
                in double aWidth,
                in double aHeight,
                in double aRadius,
                in AString aExclusionsJson);

  void setVisible(in uint32_t aId, in boolean aVisible);

  void loadURL(in uint32_t aId, in AString aURL);

  void loadHTML(in uint32_t aId, in AString aHTML, in AString aBaseURL);

  void goBack(in uint32_t aId);
  void goForward(in uint32_t aId);
  void reload(in uint32_t aId);
  void stop(in uint32_t aId);

  boolean canGoBack(in uint32_t aId);
  boolean canGoForward(in uint32_t aId);
  boolean isLoading(in uint32_t aId);

  void focus(in uint32_t aId);
  void blur(in uint32_t aId);
  boolean isFocused(in uint32_t aId);

  void setReservedShortcuts(in uint32_t aId, in AString aShortcutsJson);

  [implicit_jscontext]
  Promise evaluate(in uint32_t aId, in AString aScript);

  AString hitTestAt(in uint32_t aId, in double aX, in double aY);
  boolean acceptsFirstMouseAt(in uint32_t aId, in double aX, in double aY);

  void destroyTab(in uint32_t aId);

  // Reads back what the window server actually shows for a rect of aWindow
  // (CSS pixels, relative to the window's content), so a test can check the
  // composited colour of an engine tab (the same from every engine). Returns JSON {r, g, b, a, min, max}:
  // sRGB channel averages (0-255) plus the lowest and highest channel value
  // seen. Throws when the window can't be read.
  AString sampleWindowColor(in mozIDOMWindowProxy aWindow,
                            in double aX,
                            in double aY,
                            in double aWidth,
                            in double aHeight);

  // W30: cookie copy on an engine switch. Both work on the persistent
  // WKWebsiteDataStore named by aDataStoreId (a UUID; anything else, such as
  // "ephemeral", is refused) and only touch cookies whose domain is
  // aBaseDomain or one of its subdomains. Cookies travel as a JSON array of
  // {name, value, domain, path, expires (ms, 0 = session), secure, httpOnly,
  // sameSite ("lax", "strict", or "")}; domain keeps its leading dot for a
  // domain cookie and has none for a host-only one.
  [implicit_jscontext]
  Promise getCookies(in AString aDataStoreId, in AString aBaseDomain);

  // Resolves with the number of cookies the store accepted.
  [implicit_jscontext]
  Promise setCookies(in AString aDataStoreId,
                     in AString aBaseDomain,
                     in AString aCookiesJson);

  // W32: discards. Returns JSON {state (base64 WKWebView.interactionState),
  // url, title, scrollX, scrollY} so a discarded tab can come back with its
  // back/forward list and scroll position. state is empty when WebKit has
  // none to give.
  AString saveSessionState(in uint32_t aId);
  // Applies what saveSessionState returned to a new tab and loads its current
  // entry. Returns false when the state can't be applied (the caller then
  // loads the URL instead).
  boolean restoreSessionState(in uint32_t aId, in AString aStateJson);

  // W32: WKUIDelegate/WKNavigationDelegate requests ("dialog", "openpanel",
  // "auth", "servertrust", "media", "download-destination") reach the
  // listener with a JSON payload carrying "req"; this answers one with a JSON
  // object. Every request is answered exactly once: an unanswered one is
  // cancelled when its tab is destroyed. Credentials pass straight through to
  // WebKit and are never kept or logged.
  void respond(in uint32_t aId, in uint32_t aRequestId, in AString aResponseJson);
  // Cancels a running WKDownload ("download-*" events carry its "dl" id).
  void cancelDownload(in uint32_t aDownloadId);

  // W32: epoch guard. Each main-frame document gets a random epoch from an
  // injected script (a bfcache restore brings its document's epoch back);
  // script messages and guarded calls from any other document are dropped.
  AString currentEpoch(in uint32_t aId);
  // Runs aScript (a function body; it may await and return) in Whimsy's
  // isolated world, only if the page is still on aEpoch (empty means the
  // current one). Rejects with an AbortError when the document changed.
  [implicit_jscontext]
  Promise evaluateGuarded(in uint32_t aId, in AString aEpoch, in AString aScript);

  // W32: the system default camera and microphone, the devices WebKit
  // captures from, as JSON {camera: {name, id}, microphone: {name, id}}
  // (a missing device is left out).
  AString defaultCaptureDevices();

  // W32: logins. A trusted focus on a login field, a key the open login
  // popup takes, or a submitted login in the page's main frame reaches the
  // listener as a "login" event, its JSON "origin" verified natively (the
  // main frame's security origin, which must be the origin of the page's
  // URL). This acts on that page only while it is still on aEpoch and
  // aOrigin: {k: "fill", username, password} fills the focused login field
  // and its partner; {k: "popup", open, selected} tells the page whether the
  // login popup is open and has a selected row.
  void loginAction(in uint32_t aId, in AString aEpoch, in AString aOrigin,
                   in AString aActionJson);

  // W32: what Gecko's tab unloader weighs, as JSON {pid, footprint, audio,
  // capture}: the tab's content process and its memory footprint in bytes
  // (0 when unknown), and whether the page plays sound or captures from the
  // camera or microphone.
  AString tabActivity(in uint32_t aId);

  // Tests only: kills the tab's content process (WebKit's WebContent
  // process).
  void killContentProcessForTesting(in uint32_t aId);
};
