# W32 engine seam: the interface every engine tab service implements
# (nsIWhimsyEngineTab) and the window helpers they share (the colour
# read-back, the hit-test and paint holes in Gecko's view, and the reserved
# shortcut key monitor). Only built on macOS (see ../moz.build).

XPIDL_SOURCES += [
    "nsIWhimsyEngineTab.idl",
]

XPIDL_MODULE = "whimsy_engine"

EXPORTS.mozilla.whimsy += [
    "WhimsyEngineWindow.h",
]

UNIFIED_SOURCES += [
    "WhimsyEngineWindow.mm",
]

FINAL_LIBRARY = "xul"
