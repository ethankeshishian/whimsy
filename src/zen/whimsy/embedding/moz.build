# W23 memory-fire: on-device sentence embeddings (NaturalLanguage framework)
# for the meaning index. Only built on macOS (see ../moz.build).

XPIDL_SOURCES += [
    "nsIWhimsyEmbedding.idl",
]

XPIDL_MODULE = "whimsy_embedding"

EXPORTS.mozilla += [
    "nsWhimsyEmbedding.h",
]

SOURCES += [
    "nsWhimsyEmbedding.mm",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

OS_LIBS += [
    "-framework NaturalLanguage",
]

FINAL_LIBRARY = "xul"
