# W30 AppleScript: Cocoa scripting for Whimsy.sdef (Chrome's dictionary:
# windows, tabs, and spaces). Only built on macOS (see ../moz.build);
# WhimsyScripting.sys.mjs (../) is the front end. Cocoa finds the classes by
# the names in the sdef, so nothing here is an XPCOM component.

XPIDL_SOURCES += [
    "nsIWhimsyScripting.idl",
]

XPIDL_MODULE = "whimsy_scripting"

SOURCES += [
    "nsWhimsyScripting.mm",
]

OS_LIBS += [
    "-framework AppKit",
]

FINAL_LIBRARY = "xul"
