# w7native: Bonjour (DNS-SD) browser for the Local servers live folder.
# Only built on macOS (see ../moz.build); the app's Info.plist lists the
# browsed types in NSBonjourServices (whimsy-Info-plist-in.patch). dns_sd
# is part of libSystem; SystemConfiguration gives this Mac's .local name.

XPIDL_SOURCES += [
    "nsIWhimsyBonjour.idl",
]

XPIDL_MODULE = "whimsy_bonjour"

EXPORTS.mozilla += [
    "nsWhimsyBonjour.h",
]

SOURCES += [
    "nsWhimsyBonjour.mm",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

OS_LIBS += [
    "-framework SystemConfiguration",
]

FINAL_LIBRARY = "xul"
