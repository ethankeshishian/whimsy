XPCOM_MANIFESTS += [
    "components.conf",
]

BROWSER_CHROME_MANIFESTS += [
    "tests/browser.toml",
]

# Native components. audiotap/ is plain C++ over MediaTrackGraph (live
# captions' audio, in the content process). The rest are Objective-C++ for
# macOS: airplay/ (Cast to AirPlay's native player and route picker),
# calendar/ (Next meeting's EventKit reader, and Add to Calendar's writer;
# dropped from here by a moz.build re-sort, 1545592, so it wasn't built),
# bonjour/ (Local servers' LAN services, dns_sd), focus/ (macOS Focus for
# Whimsy's own toasts) and speech/ (live captions, on-device Speech).
DIRS += ["audiotap"]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "cocoa":
    DIRS += [
        "airplay",
        "bonjour",
        "calendar",
        "focus",
        "speech",
    ]
