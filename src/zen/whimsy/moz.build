# W29 icon-sets: Lucide and Phosphor, vendored at content/icon-packs/. Zen's
# own icons (zen-icons/, Nucleo) carry Zen's license; these two need their
# own about:license entries since they ship under different licenses.
LICENSES += ["lucide", "phosphor"]
LICENSES["lucide"].title = "Lucide icons (ISC)"
LICENSES["lucide"].text = "content/icon-packs/lucide/LICENSE"
LICENSES["phosphor"].title = "Phosphor icons (MIT)"
LICENSES["phosphor"].text = "content/icon-packs/phosphor-fill/LICENSE"

# W28: "Open in Safari" / "Open in Chrome" (research/multi-engine.md
# option A, step 1).
EXTRA_JS_MODULES.whimsy += [
    "WhimsyOpenInBrowser.sys.mjs",
]

# W30 AppleScript: the windows, tabs, and spaces scripts see (applescript/).
EXTRA_JS_MODULES.whimsy += [
    "WhimsyScripting.sys.mjs",
]

# W30 svg-save: Save Image As for SVGs (SVG, PNG or JPG).
EXTRA_JS_MODULES.whimsy += [
    "WhimsySvgSave.sys.mjs",
    "WhimsySvgSaveChild.sys.mjs",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

BROWSER_CHROME_MANIFESTS += [
    "tests/browser.toml",
]

# Native components. audiotap/ is plain C++ over MediaTrackGraph (live
# captions' audio, in the content process). The rest are Objective-C++ for
# macOS: airplay/ (Cast to AirPlay's native player and route picker),
# applescript/ (W30: Whimsy.sdef's Cocoa scripting classes),
# calendar/ (Next meeting's EventKit reader, and Add to Calendar's writer;
# dropped from here by a moz.build re-sort, 1545592, so it wasn't built),
# bonjour/ (Local servers' LAN services, dns_sd), share/ (the Share
# submenu's macOS services, wave9/menus), speech/ (live captions,
# on-device Speech), embedding/ (the meaning index's on-device sentence
# embeddings, NaturalLanguage, wave23/memory-fire), hotkey/ (W29: the
# shortcut that opens Mini Whimsy from any app, Carbon) and passkeys/ (W26:
# Whimsy's Touch ID passkeys, C++ over a Swift Secure Enclave helper).
# equalizer/ is W29's per-site equalizer DSP (plain C++, every platform).
# emoji/ (W30) tells dark pages and Boosts which pictures are emoji, so their
# colours are left alone. engine/ (W32) is the engine tab interface and the
# window helpers WebKit tabs (webkit/) share with the engines after it.
DIRS += ["audiotap", "emoji", "equalizer"]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "cocoa":
    DIRS += [
        "airplay",
        "applescript",
        "bonjour",
        "calendar",
        "embedding",
        "engine",
        "hotkey",
        "passkeys",
        "share",
        "speech",
        "webkit",
    ]
