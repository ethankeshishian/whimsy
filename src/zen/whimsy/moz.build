EXTRA_JS_MODULES.whimsy += [
    "Whimsy.sys.mjs",
    "WhimsyAI.sys.mjs",
    "WhimsyAppIcon.sys.mjs",
    "WhimsyCommandBar.sys.mjs",
    "WhimsyCookieBanners.sys.mjs",
    "WhimsyCopy.sys.mjs",
    "WhimsyExternalLinks.sys.mjs",
    "WhimsyFolderColors.sys.mjs",
    "WhimsyGithubReviews.sys.mjs",
    "WhimsyLook.sys.mjs",
    "WhimsyMedia.sys.mjs",
    "WhimsyPage.sys.mjs",
    "WhimsyPageChild.sys.mjs",
    "WhimsyPageParent.sys.mjs",
    "WhimsyShortcuts.sys.mjs",
    "WhimsySpaces.sys.mjs",
    "WhimsyStartup.sys.mjs",
    "WhimsySplit.sys.mjs",
    "WhimsyTabs.sys.mjs",
    "WhimsyUpdates.sys.mjs",
    # batch8: tab lifecycle
    "WhimsyArchive.sys.mjs",
    "WhimsyFireButton.sys.mjs",
    "WhimsyHeavyTabs.sys.mjs",
    "WhimsySnooze.sys.mjs",
    "WhimsyTreeTabs.sys.mjs",
    "WhimsyUndo.sys.mjs",
]

XPCOM_MANIFESTS += [
    "components.conf",
    "WhimsySpaceArchive.sys.mjs",  # batch9: spaces
    "WhimsySpaceLock.sys.mjs",  # batch9: spaces
]

# batch9p: Scratch and private tabs
EXTRA_JS_MODULES.whimsy += [
    "WhimsyPrivate.sys.mjs",
    # batch10: Library sidebar panels (Notes, Finder folders, Screenshot to sidebar).
    "WhimsyFilesSection.sys.mjs",
    "WhimsyFinderFoldersSection.sys.mjs",
    "WhimsyLibrarySection.sys.mjs",
    "WhimsyNotesSection.sys.mjs",
    # batch12: links & media windows
    "WhimsyQuickWindow.sys.mjs",
    "WhimsyFollowerTabs.sys.mjs",
]

BROWSER_CHROME_MANIFESTS += [
    "tests/browser.toml",
]
