# w7native/captions: a chrome-only audio tap on a captured media track, for
# live captions of videos without any (WhimsyCaptionsChild). Plain C++ over
# MediaTrackGraph listeners, so it needs no engine patch and builds on every
# platform; the recognizer it feeds (../speech) is macOS only.

XPIDL_SOURCES += [
    "nsIWhimsyAudioTap.idl",
]

XPIDL_MODULE = "whimsy_audiotap"

EXPORTS.mozilla += [
    "nsWhimsyAudioTap.h",
]

SOURCES += [
    "nsWhimsyAudioTap.cpp",
]

LOCAL_INCLUDES += [
    "/dom/media",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"
