# wave7/small: Cast to AirPlay. A native AVPlayer that plays a page's video
# on an AirPlay receiver, picked with AVKit's route picker. Only built on
# macOS (see ../moz.build); WhimsyCast.sys.mjs is the front end.

XPIDL_SOURCES += [
    "nsIWhimsyAirPlay.idl",
]

XPIDL_MODULE = "whimsy_airplay"

EXPORTS.mozilla += [
    "nsWhimsyAirPlay.h",
]

SOURCES += [
    "nsWhimsyAirPlay.mm",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

OS_LIBS += [
    "-framework AVFoundation",
    "-framework AVKit",
    "-framework CoreMedia",
]

FINAL_LIBRARY = "xul"
