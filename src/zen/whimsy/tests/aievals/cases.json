{
  "version": 1,
  "notes": "Real-model quality evals for Whimsy's AI features. Fixtures are the local pages beside this file, served from https://example.com/browser/zen/whimsy/tests/aievals/. Each case names a feature, its setup, its input, and its checks. Deterministic checks decide wherever they can; a judge check (the cheapest adequate Claude model) decides only where text quality is the question. The fake field is what the scripted provider answers when the suite runs without WHIMSY_AIEVALS=1, so the harness itself is tested on every lane without touching a real model. Never tune a case so the model passes: a failing case is a product finding.",
  "cases": [
    {
      "id": "chat-01",
      "feature": "chat",
      "title": "Which laptop is the lightest",
      "tabs": [
        "laptops.html"
      ],
      "input": "Which laptop is the lightest?",
      "checks": [
        {
          "type": "contains",
          "value": "Aero 13"
        },
        {
          "type": "max_words",
          "n": 120
        }
      ],
      "fake": "The Aero 13 is the lightest at 2.7 lb."
    },
    {
      "id": "chat-02",
