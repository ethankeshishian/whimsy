# meeting: Next meeting's macOS Calendar (EventKit) reader. Only built on
# macOS (see ../moz.build); the app's Info.plist carries the calendar usage
# strings (src/browser/app/macbuild/Contents/whimsy-Info-plist-in.patch).

XPIDL_SOURCES += [
    "nsIWhimsyCalendar.idl",
]

XPIDL_MODULE = "whimsy_calendar"

EXPORTS.mozilla += [
    "nsWhimsyCalendar.h",
]

SOURCES += [
    "nsWhimsyCalendar.mm",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

OS_LIBS += [
    "-framework EventKit",
]

FINAL_LIBRARY = "xul"
