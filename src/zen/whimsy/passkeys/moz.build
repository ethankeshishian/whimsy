# W26 passkeys: Whimsy's own Touch ID passkeys, held in this Mac's Secure
# Enclave. WhimsyPasskeyService is the nsIWebAuthnService WebAuthnService
# falls back to when Apple's passkey API isn't available to this build
# (src/dom/webauthn/whimsy-WebAuthnService-h.patch); WhimsyPasskeys.sys.mjs
# (../) is the front end. The Secure Enclave itself is only reachable from
# Swift (CryptoKit), so a small helper app is compiled with swiftc and
# bundled as whimsy-passkeys.app beside plugin-container.app.

XPIDL_SOURCES += [
    "nsIWhimsyPasskeys.idl",
]

XPIDL_MODULE = "whimsy_passkeys"

EXPORTS.mozilla += [
    "WhimsyPasskeyService.h",
]

UNIFIED_SOURCES += [
    "WhimsyPasskeyService.cpp",
]

LOCAL_INCLUDES += [
    "/dom/webauthn",
]

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"

# The helper: one Swift file, built by helper/build.py, wrapped in an app
# bundle so the Touch ID sheet names it ("Whimsy is trying to …") and the
# bundle's signature covers it.
GeneratedFile(
    "whimsy-passkeys",
    script="helper/build.py",
    entry_point="main",
    inputs=["helper/main.swift"],
)

# Beside plugin-container.app in Contents/MacOS (GreBinD, where
# WhimsyPasskeys.sys.mjs looks and @BINPATH@ in the package manifest), not
# this directory's FINAL_TARGET, which browser/'s DIST_SUBDIR makes
# Contents/Resources/browser.
MacOSBundle(
    "!/dist/bin/whimsy-passkeys.app",
    skeleton="helper/macbuild/Contents",
    binaries=[("!whimsy-passkeys", "whimsy-passkeys")],
)
