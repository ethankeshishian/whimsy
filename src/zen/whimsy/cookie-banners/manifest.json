{
  "manifest_version": 2,
  "name": "Whimsy Cookie Banners",
  "description": "Rejects cookie banners for you, with DuckDuckGo's Autoconsent rules.",
  "version": "17.0.0",
  "browser_specific_settings": {
    "gecko": { "id": "cookie-banners@whimsy.browser" }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module",
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["autoconsent/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "permissions": ["scripting", "*://*/*"]
}
