# W29: the system-wide shortcut that opens Mini Whimsy from any app
# (RegisterEventHotKey, Carbon). Only built on macOS (see ../moz.build).

XPIDL_SOURCES += [
    "nsIWhimsyGlobalHotKey.idl",
]

XPIDL_MODULE = "whimsy_hotkey"

EXPORTS.mozilla += [
    "nsWhimsyGlobalHotKey.h",
]

SOURCES += [
    "nsWhimsyGlobalHotKey.mm",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

OS_LIBS += [
    "-framework Carbon",
]

FINAL_LIBRARY = "xul"
