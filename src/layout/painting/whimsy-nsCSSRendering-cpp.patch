                                               float aOpacity) {
   // Get the shadow color; if not specified, use the foreground color
   nscolor shadowColor = aShadow.color.CalcColor(aFrame);
+  // Whimsy: on a recoloured page a blurred shadow stays a dark shadow of the
+  // same shape instead of inverting into a light halo.
+  if (aShadow.blur.ToAppUnits() > 0) {
+    shadowColor = whimsy::DarkShadowColor(
+        shadowColor, aShadow.color.CalcColor(aFrame->StyleText()->mColor),
