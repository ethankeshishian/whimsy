+void HTMLMediaElement::WhimsySetEqualizer(const Sequence<float>& aGains) {
+  for (size_t i = 0; i < std::size(mWhimsyEqualizerGains); i++) {
+    mWhimsyEqualizerGains[i] = i < aGains.Length() ? aGains[i] : 0.0f;
+  }
+  if (mDecoder) {
+    mDecoder->WhimsyEqualizer()->SetGains(mWhimsyEqualizerGains,
+                                          std::size(mWhimsyEqualizerGains));
+  }
+}
+
+bool HTMLMediaElement::WhimsyEqualizerApplies() const {
+  if (mDecoder) {
+    return mDecoder->WhimsyEqualizerApplies();
+  }
+  return !mSrcStream;
