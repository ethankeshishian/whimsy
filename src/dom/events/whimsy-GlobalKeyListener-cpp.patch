+// Whimsy: "Pass Keys to Page". While the browser's own chrome marks a tab's
+// <browser> with whimsy-pass-keys, its page gets the reserved keys (New Tab,
+// Close Tab, ...) the way fullscreen keyboard lock gives them, without full
+// screen; the exit-full-screen key stays the browser's. macOS's own keys (Quit,
+// Hide, Minimize) are the menu's (internal <key>s) and never come here.
+static bool WhimsyPassKeysTarget(WidgetKeyboardEvent* aKeyEvent) {
+  nsIContent* content =
+      nsIContent::FromEventTargetOrNull(aKeyEvent->mOriginalTarget);
+  return content && content->IsXULElement(nsGkAtoms::browser) &&
+         nsContentUtils::IsChromeDoc(content->OwnerDoc()) &&
+         content->AsElement()->HasAttribute(u"whimsy-pass-keys"_ns);
+}
