+nscolor CanvasRenderingContext2D::WhimsyMapColor(nscolor aColor) const {
+  return whimsy::MapDarkColor(aColor, whimsy::DarkMappingFrame(mCanvasElement));
+}
+
+already_AddRefed<GradientStops> CanvasRenderingContext2D::WhimsyGradientStops(
+    CanvasGradient* aGradient, DrawTarget* aRT) const {
+  nsIFrame* frame = whimsy::DarkMappingFrame(mCanvasElement);
+  if (!frame) {
+    return aGradient->GetGradientStopsForTarget(aRT);
+  }
+  nsTArray<GradientStop> stops = aGradient->WhimsyRawStops().Clone();
+  const nsTArray<nscolor>& colors = aGradient->WhimsyColors();
+  for (size_t i = 0; i < stops.Length() && i < colors.Length(); i++) {
+    stops[i].color = ToDeviceColor(whimsy::MapDarkColor(colors[i], frame));
+  }
+  return gfx::gfxGradientCache::GetOrCreateGradientStops(aRT, stops,
+                                                         ExtendMode::CLAMP);
+}
+
+void CanvasRenderingContext2D::WhimsyNoteDraw() {
+  const bool mapped = !!whimsy::DarkMappingFrame(mCanvasElement);
+  if (mWhimsyMapped == Some(mapped)) {
+    return;
+  }
+  mWhimsyMapped = Some(mapped);
+  // Whether the canvas needs a display-time filter may have changed.
+  if (mCanvasElement) {
+    if (nsIFrame* frame = mCanvasElement->GetPrimaryFrame()) {
+      frame->InvalidateFrame();
+    }
+  }
+}
